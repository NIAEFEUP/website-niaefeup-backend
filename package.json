{
  "name": "website-niaefeup-backend",
  "version": "0.0.1",
  "description": "Backend API for NIAEFEUP's website.",
  "author": {
    "name": "NIAEFEUP",
    "email": "ni@aefeup.pt",
    "url": "https://niaefeup.pt/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NIAEFEUP/website-niaefeup-backend.git"
  },
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "seed": "node dist/database/seed.js",
    "schema:create": "node dist/database/schema.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "biome format --write",
    "format:check": "biome check",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "typeorm-extension": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.0.0",
    "better-sqlite3": "^12.11.1",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3"
  }
}
